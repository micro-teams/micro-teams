{
  "expo": {
    "name": "MicroTeams",
    "slug": "microteams",
    "version": "0.1.19",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "android": {
      "package": "app.microteams.microteams",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07C160"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "app.microteams"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/release-signing"
    ]
  }
}
