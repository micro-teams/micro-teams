<?xml version="1.0" encoding="utf-8"?>
<!--
    What the window is while the process starts. The app's own background, not white: the launch
    used to flash white and then turn near-black the moment Flutter drew, which reads as a fault in
    the app rather than as it starting.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
